# ─── SmythOS SDK Integration Tests ────────────────────────────────────────────
#
# Copy this file to .env in the repo root and fill in the keys you have.
# Only set the keys for providers you want to test — tests skip gracefully
# when a key is missing.
#
# Alternatively, put keys in your vault file (~/.smyth/vault.json):
#   { "default": { "openai": "sk-...", "anthropic": "sk-ant-...", ... } }
#
# ─── Run commands ────────────────────────────────────────────────────────────
#
#   pnpm test:integration           — run all integration tests
#   pnpm test:integration:local     — run only local tests (no LLM API calls)
#   pnpm test:unit                  — run only unit tests
#
# ─── LLM Providers ──────────────────────────────────────────────────────────

# OpenAI (GPT-4o-mini, text-embedding-3-large)
OPENAI_API_KEY=

# Anthropic (Claude Sonnet)
ANTHROPIC_API_KEY=

# Google AI (Gemini 2.0 Flash)
GOOGLE_AI_API_KEY=

# Groq (Llama 3.1)
GROQ_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Together AI (Meta Llama)
TOGETHER_AI_API_KEY=

# Perplexity (Sonar)
PERPLEXITY_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# ─── Vector Database ─────────────────────────────────────────────────────────

# Pinecone — also set PINECONE_INDEX
PINECONE_API_KEY=
PINECONE_INDEX=

# Milvus — use token OR user/password (not both)
MILVUS_ADDRESS=
MILVUS_TOKEN=
# MILVUS_USER=
# MILVUS_PASSWORD=

# ─── Cache ───────────────────────────────────────────────────────────────────

# Redis (host:port format or redis:// URL)
REDIS_URL=

# ─── AWS (S3 Storage, S3 Cache, Secrets Manager Vault, Bedrock) ──────────────
#
# AWS credentials are shared across: S3 Storage, S3 Cache, Secrets Manager Vault
# Set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY to enable all AWS-based tests.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 Storage (bucket name for Storage.S3)
S3_BUCKET_NAME=

# S3 Cache (bucket name for Cache.S3)
S3_CACHE_BUCKET_NAME=

# AWS Secrets Manager Vault
# Secrets should be stored as: smythos/{teamId}/{secretName}
# The test reads from the 'default' team namespace.
